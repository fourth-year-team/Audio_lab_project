<Window x:Class="AudioLabProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:AudioLabProject.ViewModels"
        xmlns:conv="clr-namespace:AudioLabProject.Converters"
        mc:Ignorable="d"
        Title="AudioLab Pro" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B1121" AllowDrop="True" Drop="Window_Drop"
        TextElement.FontFamily="Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        
<Color x:Key="PrimaryColor">#6366F1</Color>
        <Color x:Key="PrimaryLight">#818CF8</Color>
        <Color x:Key="AccentCyan">#06B6D4</Color>
        <Color x:Key="SuccessGreen">#10B981</Color>
        <Color x:Key="DangerRed">#EF4444</Color>
        <Color x:Key="WarningAmber">#F59E0B</Color>
        <Color x:Key="BgBase">#0B1121</Color>
        <Color x:Key="BgSurface">#131C31</Color>
        <Color x:Key="BgCard">#1A233A</Color>
        <Color x:Key="BgElevated">#1E293B</Color>
        <Color x:Key="BgHover">#243049</Color>
        <Color x:Key="BorderDefault">#1E3A5F</Color>
        <Color x:Key="BorderSubtle">#1E293B</Color>
        <Color x:Key="TextPrimary">#F1F5F9</Color>
        <Color x:Key="TextSecondary">#94A3B8</Color>
        <Color x:Key="TextMuted">#64748B</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource AccentCyan}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerRed}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningAmber}"/>
        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BgBase}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource BgSurface}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource BgElevated}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource BgHover}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderDefault}"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

        
<LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E293B" Offset="0"/>
            <GradientStop Color="#18233A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
            <GradientStop Color="{StaticResource AccentCyan}" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SidebarBg" Color="#0A0F1D"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="{StaticResource PrimaryColor}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DragOverBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraggingOver}" Value="True">
                    <Setter Property="Background" Value="#336366F1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeScreenStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFileSelected}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BaseBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="0" Margin="{TemplateBinding Padding}" Text="{TemplateBinding Text}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Width="30" BorderThickness="0" Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" CornerRadius="0,8,8,0">
                                                    <TextBlock Text="▼" FontSize="8" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MaxHeight="300">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="10,7" CornerRadius="5">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuantizationComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border x:Name="PART_Track" CornerRadius="4">
                                <Border x:Name="PART_Indicator" Background="{StaticResource PrimaryGradient}" CornerRadius="4" HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel AllowDrop="True" LastChildFill="True">

        
<StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem Margin="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
<Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,0">
                    <StackPanel>
                        
<TextBlock Text="AUDIO FILE" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="File Name" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Metadata.FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,12"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Duration" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metadata.DurationDisplay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="File Size" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metadata.FileSize, StringFormat={}{0:N0} B}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Sample Rate" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metadata.SampleRate, StringFormat={}{0} Hz}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Channels" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metadata.Channels}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="Bit Rate" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metadata.BitRate, StringFormat={}{0:N0} bps}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                        <TextBlock Text="Encoding" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metadata.Encoding}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        
<TextBlock Text="GLOBAL SETTINGS" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Target Sample Rate (Hz)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TargetSampleRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                
                                <TextBlock Text="Quantization (Bits)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0"/>
                                <ComboBox Style="{StaticResource QuantizationComboBox}" ItemsSource="{Binding AvailableBitDepths}" 
                                          SelectedItem="{Binding QuantizationBits}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        
<TextBlock Text="ALGORITHM" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" 
                                  ItemsSource="{Binding Algorithms}" 
                                  SelectedItem="{Binding SelectedAlgorithm}" 
                                  DisplayMemberPath="Name" 
                                  Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                
<StackPanel Visibility="{Binding SelectedAlgorithm.Name, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Delta Modulation'}">
                                    <TextBlock Text="Step Size" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SelectedAlgorithm.StepSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                </StackPanel>

                                
<StackPanel Visibility="{Binding SelectedAlgorithm.Name, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Adaptive Delta Modulation'}">
                                    <TextBlock Text="Min Step" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SelectedAlgorithm.MinStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                    <TextBlock Text="Multiplier" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SelectedAlgorithm.Multiplier, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                </StackPanel>

                                
<StackPanel Visibility="{Binding SelectedAlgorithm.Name, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Nonlinear Quantization (Mu-law)'}">
                                    <TextBlock Text="Mu Constant" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SelectedAlgorithm.Mu, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                </StackPanel>
                                
                                <TextBlock Text="Standard DPCM — no parameters" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                           Visibility="{Binding SelectedAlgorithm.Name, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='DPCM'}"/>
                            </StackPanel>
                        </Border>

                        
<Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="COMPRESS" Command="{Binding ProcessCompressionCommand}" Style="{StaticResource ProcessButtonStyle}"/>
                            <Button Content="CANCEL" Command="{Binding CancelCompressionCommand}" Style="{StaticResource CancelButtonStyle}"/>
                            <Button Grid.Column="1" Content="↺" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" Width="42" Padding="0" Margin="8,0,0,0" FontSize="18"/>
                        </Grid>

                        
<Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PROGRESS" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CompressionProgress, StringFormat={}{0:F0}%}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding CompressionProgress}" Style="{StaticResource ProgressBarStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            
<Grid Grid.Column="1" Background="{StaticResource BaseBrush}">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    
<Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶ Original" Command="{Binding PlayOriginalCommand}" Style="{StaticResource IconButton}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <Button Content="▶ Processed" Command="{Binding PlayProcessedCommand}" Style="{StaticResource IconButton}" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0"/>
                                <Button Content="■ Stop" Command="{Binding StopPlaybackCommand}" Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Export WAV" Click="SaveButton_Click" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}"/>
                        </Grid>
                    </Border>

                    
<Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="COMPRESSION EFFICIENCY" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding CompressionRatioSeries}" 
                                    ZoomMode="X" TooltipPosition="Top"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="PROCESSING SPEED" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding ProcessingSpeedSeries}"
                                    ZoomMode="X" TooltipPosition="Top"/>
                            </Grid>
                        </Border>

                        
<Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Padding="20" Margin="0,20,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Algorithm" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.AlgorithmName}" Foreground="{StaticResource PrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                                        <TextBlock Text="Parameters" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.Parameters}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SNR" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.SnrDisplay}" Foreground="{StaticResource PrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Savings" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.SavingsPercentage, StringFormat={}{0:F1}%}" Foreground="{StaticResource SuccessBrush}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Grid.Row="1" Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="Input Size" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.OriginalSize, StringFormat={}{0:N0} B}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Output Size" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.CompressedSize, StringFormat={}{0:N0} B}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Latency" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastResult.ProcessingTimeDisplay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Status" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            
<Border Grid.ColumnSpan="2" Style="{StaticResource DragOverBorderStyle}" IsHitTestVisible="False" Panel.ZIndex="100"/>

            
<Border Grid.ColumnSpan="2" Panel.ZIndex="50" Background="#F00B1121" Style="{StaticResource WelcomeScreenStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="110" Height="110" CornerRadius="55" Margin="0,0,0,28" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2">
                        <Border Background="{StaticResource CardGradient}" CornerRadius="55">
                            <TextBlock Text="♫" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </Border>
                    <TextBlock Text="AudioLab Pro" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Professional Audio Compression Suite" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,36"/>
                    
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="36" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="420">
                        <StackPanel>
                            <TextBlock Text="Drop your audio file to begin" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Border Width="100" Height="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Button Content="Browse Files" Command="{Binding BrowseFileCommand}" Style="{StaticResource ModernButton}" Width="200" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Supports WAV · MP3 · FLAC · M4A" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
